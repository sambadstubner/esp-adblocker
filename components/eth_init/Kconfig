menu "Ethernet (W5500) Configuration"

    config ETH_INIT_SPI_HOST
        int "SPI host for W5500"
        default 1
        help
            SPI peripheral used for the W5500 Ethernet chip.
            0 = SPI1_HOST (reserved for flash, do not use)
            1 = SPI2_HOST
            2 = SPI3_HOST
            The SD card (sd_storage component) must use a different host than this one.

    config ETH_INIT_MISO_GPIO
        int "W5500 MISO GPIO"
        default 12
        help
            Confirmed pinout for the Waveshare ESP32-S3-ETH onboard W5500.

    config ETH_INIT_MOSI_GPIO
        int "W5500 MOSI GPIO"
        default 11

    config ETH_INIT_SCLK_GPIO
        int "W5500 SCLK GPIO"
        default 13

    config ETH_INIT_CS_GPIO
        int "W5500 CS GPIO"
        default 14

    config ETH_INIT_RST_GPIO
        int "W5500 RST GPIO"
        default 9

    config ETH_INIT_INT_GPIO
        int "W5500 INT GPIO"
        default 10

    config ETH_INIT_SPI_CLOCK_MHZ
        int "W5500 SPI clock speed (MHz)"
        default 20
        help
            W5500 supports higher clocks depending on board wiring quality;
            20MHz is the conservative default used by Espressif's own examples.

endmenu
